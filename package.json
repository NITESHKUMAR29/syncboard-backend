{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow backend — REST + WebSocket API for the TaskFlow Android app",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "db:migrate:create": "prisma migrate dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "pglite-prisma-adapter": "0.7.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.7",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
