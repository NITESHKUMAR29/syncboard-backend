# Copy to .env and adjust. No real secrets belong in this file or in the repository.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Local PostgreSQL from docker-compose.yml:
DATABASE_URL=postgresql://taskflow:localdev@localhost:5432/taskflow
# Or a managed database such as Neon — use the DIRECT (unpooled) connection string, since
# this is a long-running server that holds its own pool:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/taskflow?sslmode=require

# Only needed for `prisma migrate dev` against a managed database: a second, empty
# database used as a throwaway to verify migrations. Leave unset for local PostgreSQL.
SHADOW_DATABASE_URL=

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=taskflow
JWT_AUDIENCE=taskflow-android
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# BCrypt work factor. Leave at 12; only the test suite lowers it for speed.
BCRYPT_COST=12

# File storage. Leave STORAGE_BUCKET empty to store uploads on local disk.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_LOCAL_DIR=./uploads
# Used to build absolute URLs for locally stored files.
PUBLIC_BASE_URL=http://localhost:8080

# Base64-encoded Firebase service account. Empty means push payloads are only logged.
FIREBASE_CREDENTIALS_JSON=

# Comma-separated. Empty disables cross-origin requests; only Swagger UI or a future web
# client needs this.
CORS_ALLOWED_ORIGINS=

ENABLE_SWAGGER_UI=true
