# Copy to .env and adjust. No real secrets belong in this file or in the repository.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://taskflow:localdev@localhost:5432/taskflow

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ISSUER=taskflow
JWT_AUDIENCE=taskflow-android
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# File storage. Leave STORAGE_BUCKET empty to store uploads on local disk.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_LOCAL_DIR=./uploads
# Used to build absolute URLs for locally stored files.
PUBLIC_BASE_URL=http://localhost:8080

# Base64-encoded Firebase service account. Empty means push payloads are only logged.
FIREBASE_CREDENTIALS_JSON=

# Comma-separated. Empty disables cross-origin requests; only Swagger UI or a future web
# client needs this.
CORS_ALLOWED_ORIGINS=

ENABLE_SWAGGER_UI=true
